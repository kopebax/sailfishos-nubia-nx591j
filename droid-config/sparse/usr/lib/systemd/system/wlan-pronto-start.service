[Unit]
Description=Uruchomienie wbudowanego sterownika WLAN Pronto (nx591j)
After=droid-hal-init.service
Before=connman.service
ConditionPathExists=/sys/module/wlan/parameters/fwpath

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sh -c "for i in $(seq 30); do [ -e /dev/wcnss_wlan ] && break; sleep 1; done"
ExecStart=/bin/sh -c "echo sta > /sys/module/wlan/parameters/fwpath"
ExecStartPost=/bin/sh -c "for i in $(seq 20); do [ -e /sys/class/net/wlan0 ] && exit 0; sleep 1; done"

[Install]
WantedBy=multi-user.target
