From 38e61e9031a26335929c41e7249283be2fd369c3 Mon Sep 17 00:00:00 2001
From: kopebax <kopebax@users.noreply.github.com>
Date: Fri, 30 Oct 2026 01:41:17 +0100
Subject: [PATCH] (hybris) rootdir: don't run init_user0 (vdc waits forever for
 vold)

Change-Id: Ia65c2b487af598a1f7099a14d38163170b5da5db
---
 rootdir/init.rc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index 1c80f1f..ae2a266 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -480,7 +480,7 @@ on post-fs-data
     mkdir /data/cache/backup_stage 0700 system system
     mkdir /data/cache/backup 0700 system system
 
-    init_user0
+    # init_user0: (hybris) no vold in Sailfish OS; "vdc --wait" blocked init before "on boot"
 
     # Reload policy from /data/security if present.
     setprop selinux.reload_policy 1
-- 
2.56.0

